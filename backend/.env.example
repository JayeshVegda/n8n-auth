# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/auth-app

# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret Key (use a strong random string in production)
JWT_SECRET=your-secret-key-change-in-production

# Frontend URL (for CORS)
# For Vercel: https://your-app.vercel.app
# Multiple URLs: https://app1.vercel.app,https://app2.vercel.app
# Note: Backend automatically allows all *.vercel.app domains
FRONTEND_URL=http://localhost:3000

# N8N Webhook URLs (for email workflows)
N8N_WELCOME_URL=https://your-n8n-instance.com/webhook/welcome
N8N_OTP_URL=https://your-n8n-instance.com/webhook/send-otp

